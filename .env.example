# ===== CodeWise 根目录环境变量示例 =====
# 复制本文件为 .env 后按需修改；docker compose 启动时自动注入各服务

# ===== LLM 调用（注入 backend 服务） =====
# OpenAI 兼容 API Key（必填，支持 DeepSeek/通义等兼容服务）
# 示例：OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxx"
OPENAI_API_KEY="your-api-key-here"
# API Base URL：默认 OpenAI 官方，可替换为其他 OpenAI 兼容端点
OPENAI_BASE_URL="https://api.openai.com/v1"
# 模型名称（与 backend/.env.example 保持一致）
LLM_MODEL="gpt-4o-mini"
# 轻量模型：审查分类/测试生成/反思/总结等受控输出角色使用（省推理时间）。
# 留空回落 LLM_MODEL（行为兼容）；建议配置为同厂商的非推理快速模型
LLM_FAST_MODEL=""

# ===== 服务端口映射（宿主机端口:容器端口） =====
# backend 服务对外端口
BACKEND_PORT=8000
# frontend 服务对外端口
FRONTEND_PORT=80
# chromadb 服务对外端口
CHROMA_PORT=8001
# nginx 反向代理对外端口
NGINX_PORT=8080

# ===== 数据持久化（宿主机挂载目录） =====
# ChromaDB 向量数据宿主机目录
CHROMA_DATA_DIR=./data/chroma

# ===== MySQL（注入 mysql / backend 服务） =====
# MySQL root 密码（mysql 容器初始化与探活）
MYSQL_ROOT_PASSWORD=codewise
# 应用专用账号密码（backend 经 DATABASE_URL 连接，非 root）
MYSQL_PASSWORD=codewise

# ===== 日志 =====
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ===== API 鉴权与限流（注入 backend 服务） =====
# API Key：配置后所有 /api/* 接口要求请求头 X-API-Key 与之相等；留空则关闭鉴权（本地开发模式）
API_KEY=
# /api/agent 限流：窗口期内单 IP 最大请求数（防 LLM 成本失控）
RATE_LIMIT_TIMES=10
# 限流滑动窗口大小（秒）
RATE_LIMIT_WINDOW=60
