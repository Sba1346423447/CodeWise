# ===== CodeWise 根目录环境变量示例 =====
# 复制本文件为 .env 后按需修改；docker compose 启动时自动注入各服务

# ===== LLM 调用（注入 backend 服务） =====
# OpenAI 兼容 API Key（必填，支持 DeepSeek/通义等兼容服务）
# 示例：OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxx"
OPENAI_API_KEY="your-api-key-here"
# API Base URL：默认 OpenAI 官方，可替换为其他 OpenAI 兼容端点
OPENAI_BASE_URL="https://api.openai.com/v1"
# 模型名称（与 backend/.env.example 保持一致）
LLM_MODEL="gpt-4o-mini"

# ===== 服务端口映射（宿主机端口:容器端口） =====
# backend 服务对外端口
BACKEND_PORT=8000
# frontend 服务对外端口
FRONTEND_PORT=80
# chromadb 服务对外端口
CHROMA_PORT=8001
# nginx 反向代理对外端口
NGINX_PORT=8080

# ===== 数据持久化（宿主机挂载目录） =====
# ChromaDB 向量数据宿主机目录
CHROMA_DATA_DIR=./data/chroma
# SQLite 数据库宿主机目录
SQLITE_DATA_DIR=./data/sqlite

# ===== 日志 =====
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
