# ===== CodeWise 后端环境变量示例 =====
# 复制本文件为 backend/.env 后按需修改；所有配置均可被环境变量覆盖

# ===== LLM 调用配置 =====
# OpenAI 兼容 API Key（必填，支持 DeepSeek/通义等兼容服务）
# 示例：OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxx"
OPENAI_API_KEY="your-api-key-here"
# API Base URL：默认 OpenAI 官方，可替换为其他 OpenAI 兼容端点
OPENAI_BASE_URL="https://api.openai.com/v1"
# 模型名称（须与 config/settings.yaml 中的模型配置保持一致）
LLM_MODEL="gpt-4o-mini"

# ===== 后端服务 =====
# 服务监听地址与端口（Docker 部署时由 docker-compose 注入覆盖）
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ===== 数据库 =====
# SQLite 数据库文件路径（相对 backend 目录）
DATABASE_URL=sqlite+aiosqlite:///./codewise.db

# ===== 沙箱执行 =====
# 隔离沙箱代码执行超时时间（秒）
SANDBOX_TIMEOUT=30
# 沙箱工作目录（留空则自动使用系统临时目录）
SANDBOX_DIR=

# ===== 向量库 =====
# ChromaDB 持久化目录（相对 backend 目录）
CHROMA_PERSIST_DIR=./chroma_data

# ===== CORS =====
# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
