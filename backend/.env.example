# ===== CodeWise 后端环境变量示例 =====
# 复制本文件为 backend/.env 后按需修改；所有配置均可被环境变量覆盖

# ===== LLM 调用配置 =====
# OpenAI 兼容 API Key（必填，支持 DeepSeek/通义等兼容服务）
# 示例：OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxx"
OPENAI_API_KEY="your-api-key-here"
# API Base URL：默认 OpenAI 官方，可替换为其他 OpenAI 兼容端点
OPENAI_BASE_URL="https://api.openai.com/v1"
# 模型名称（须与 config/settings.yaml 中的模型配置保持一致）
LLM_MODEL="gpt-4o-mini"
# 轻量模型（审查/测试生成/反思/总结角色）：留空回落 LLM_MODEL
LLM_FAST_MODEL=""
# 以下 LLM 参数为可选覆盖项：不设置时使用 config/settings.yaml 的默认值
# 采样温度：越低越稳定，越高越有创造力
# LLM_TEMPERATURE=0.2
# 单次生成最大 token 数（推理模型长推理场景建议给足预算）
# LLM_MAX_TOKENS=4096
# 单次 LLM 请求超时（秒）：复杂代码场景可能耗时超 60s
# LLM_REQUEST_TIMEOUT=120

# ===== 后端服务 =====
# 服务监听地址与端口（Docker 部署时由 docker-compose 注入覆盖）
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志输出目录（相对 backend 目录；可选，默认 logs）
# LOG_DIR=logs

# ===== 数据库 =====
# MySQL 连接串（格式 mysql+aiomysql://用户:密码@主机:端口/库名）
DATABASE_URL=mysql+aiomysql://root:你的密码@127.0.0.1:3306/codewise
# 测试专用库连接串（pytest 使用，见 tests/conftest.py；CI 由环境变量注入）
TEST_DATABASE_URL=mysql+aiomysql://root:你的密码@127.0.0.1:3306/codewise_test

# ===== Agent 编排 =====
# ReAct 循环最大迭代次数：防止 LLM 决策失控导致死循环（可选，默认 4）
# MAX_REACT_ITERATIONS=4

# ===== 沙箱执行 =====
# 隔离沙箱代码执行超时时间（秒）
SANDBOX_TIMEOUT=30
# 沙箱工作目录（留空则自动使用系统临时目录）
SANDBOX_DIR=

# ===== 向量库 =====
# ChromaDB 服务地址与端口（Docker 部署时指向容器服务名 chromadb:8000）
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# ===== CORS =====
# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== API 鉴权与限流 =====
# API Key：配置后所有 /api/* 接口要求请求头 X-API-Key 与之相等；留空则关闭鉴权（本地开发模式）
# 前端对应配置：localStorage["codewise_api_key"] 或 frontend 构建时 VITE_API_KEY
API_KEY=
# /api/agent 限流：窗口期内单 IP 最大请求数
RATE_LIMIT_TIMES=10
# 限流滑动窗口大小（秒）
RATE_LIMIT_WINDOW=60
